# env.hybrid.example - Self-hosted + Cloud (production)
# Copy to .env when using docker-compose.hybrid.yml

# REQUIRED: OmniRoute API key (generate in OmniRoute UI)
OMNIROUTE_API_KEY=sk-your-hybrid-api-key-here

# Optional: Pre-configured combo to monitor (health-monitor)
# Can be comma-separated: "Local-Coding-Stack,Hybrid-Best-of-Both"
COMBO_ID=Hybrid-Best-of-Both

# Health monitor settings
INTERVAL_SEC=300
AUTO_APPLY=false

# Cloud API keys
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Local model server settings (if running in Docker)
# OLLAMA_MODELS=codellama:34b llama3.2 mistral:7b
# VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# VLLM_API_KEY=
# HF_TOKEN=
# LLAMACPP_MODEL=llama-3.2-3b-instruct-q4_k_m.gguf