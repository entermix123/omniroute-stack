# env.cloud.example - Cloud providers only
# Copy to .env when using docker-compose.cloud.yml

# REQUIRED: OmniRoute API key (generate in OmniRoute UI)
OMNIROUTE_API_KEY=sk-your-cloud-api-key-here

# Optional: Pre-configured combo to monitor (health-monitor)
COMBO_ID=Nvidia-Free-Stack

# Health monitor settings
INTERVAL_SEC=300
AUTO_APPLY=false

# Cloud API keys (optional - can enter in OmniRoute UI instead)
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=