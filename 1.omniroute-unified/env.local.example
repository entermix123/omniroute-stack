# env.local.example - Self-hosted models only
# Copy to .env when using docker-compose.local.yml

# REQUIRED: OmniRoute API key (generate in OmniRoute UI)
OMNIROUTE_API_KEY=sk-your-local-api-key-here

# Optional: Pre-configured combo to monitor (health-monitor)
# Leave empty to auto-discover all combos
COMBO_ID=Local-Coding-Stack

# Health monitor settings
INTERVAL_SEC=300          # 5 minutes
AUTO_APPLY=false          # Set true to auto-reorder combo priorities

# Local model server settings (if running in Docker)
# OLLAMA_MODELS=codellama:34b llama3.2 mistral:7b
# VLLM_MODEL=meta-llama/Llama-3.2-3B-Instruct
# VLLM_API_KEY=
# HF_TOKEN=                 # For gated models on Hugging Face
# LLAMACPP_MODEL=llama-3.2-3b-instruct-q4_k_m.gguf